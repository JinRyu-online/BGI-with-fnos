# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Windows listener 运行时生成文件（由 install.ps1 从 .example 生成，勿提交）
windows-listener/venv/
windows-listener/config.toml
windows-listener/tasks/tasks.json
windows-listener/trusted.json
windows-listener/.first_run_done
windows-listener/var/
windows-listener/log/

# NAS FPK 应用构建产物
nas-app/**/*.fpk
nas-app/app/docker/.build/

# 前端 SPA（nas-app/frontend）构建产物：部署产物 static/spa/ 是否入库见部署策略，
# 此处仅忽略本地构建目录与依赖
nas-app/frontend/node_modules/
nas-app/frontend/dist/
nas-app/frontend/*.local

# ZCode 本地工具目录
.zcode/

# fnpack 打包产物
*.fpk

# Apifox AI Agent skills（本地工具安装，npx skills add 生成，勿提交）
.agents/
skills/
skills-lock.json
.claude/skills/
.codebuddy/
.hermes/
.lingma/
.qoder/
.trae/
.windsurf/

# Apifox CLI 本地配置（projectId 等）
.apifox/
