# BetterGI Trigger Listener 配置文件
# 首次启动若 api_key 为空，会自动生成随机密钥并回写、弹窗显示。
# 路径反斜杠需双写（如 "D:\\Games\\BetterGI\\BetterGI.exe"），或用正斜杠。

[server]
# HTTP 监听地址。0.0.0.0 表示监听所有网卡（局域网可达）。
host = "0.0.0.0"
# 监听端口。NAS 扫描默认探测此端口，需在 Windows 防火墙放行。
port = 8765

[auth]
# API 密钥。留空：首次启动自动生成 32 位随机密钥并弹窗显示（复制到 NAS 应用）。
# 也可手动填入自定义密钥，但需与 NAS 应用配置里的一致。
api_key = ""
# 已信任 IP 列表。首次收到「带正确密钥」的请求时自动学习来源 IP，无需手填。
# 手动填可预授权，如 ["192.168.1.50"]。
trusted_ips = []

[bettergi]
# ★ 配置简化（推荐）：只写一行 dir，其它路径自动推导。
#   推导规则：exe_path = {dir}/BetterGI.exe ；config_path = {dir}/config ；
#            log_path  = {dir}/log/better-genshin-impact*.log（glob，按天自动发现）
#   推导仅当对应字段"未显式配置"时生效：若同时写了 dir 与某个显式字段，以显式字段为准。
#   示例：dir = "D:/software/BetterGI"
dir = ""
# --- 以下为显式字段，留空则使用 dir 的推导值（dir 为空时这些字段必填） ---
# BetterGI.exe 的完整路径。必填（生产环境）。留空则触发会失败（仅开发调试用）。
# 示例：exe_path = "D:\\software\\BetterGI\\BetterGI.exe"
exe_path = ""
# BetterGI 调度器配置文件路径（可选，用于自动读取组名预填任务）。留空则不自动读取。
config_path = ""
# BetterGI 日志文件路径。填了才启用完成判定 C（日志关键字）。
# 留空 -> 完成判定只用 B（游戏进程退出）+ 24h 超时安全兜底。
# ★ 支持 glob 模式（按天自动发现）:例如 "C:/Software/BetterGI/log/better-genshin-impact*.log"
#   省略日期部分,收割器会自动取匹配结果中最新(mtime 最大)的文件。
log_path = ""
# 日志中表示调度组整体执行完成的关键字。需配合 log_path 使用，留空 -> C 禁用。
# 推荐带双引号的 "任务结束"(BetterGI TaskRunner 在整组跑完后打印，仅 1 次)。
# ★ 必须带双引号 —— 子任务/分组结束会打 "→ 钓鱼任务结束"/"→ 挖矿任务结束"(无引号),
#   若写成无引号的 任务结束 会误把子任务当整体完成,提前触发 C 判定。
# ★ 不要用 "脚本执行结束" —— 那是每个子脚本跑完都打一次的字样,会误触发 C 禁用。
log_done_keyword = '"任务结束"'
# 完成判定 B 监视的游戏进程名。国服 YuanShen.exe，国际服 GenshinImpact.exe。
# 二者都列可兼容；若玩其他服请改成实际进程名。
game_processes = ["YuanShen.exe", "GenshinImpact.exe"]

[execution]
# 任务默认最大执行时长（分钟）。超时则标记 timeout 并尝试清理。
default_timeout_min = 90
# 任务默认收尾动作：sleep 休眠(默认,可被WOL唤醒) / shutdown 关机 / lock 锁屏 / none 不动作。
# 休眠需 Windows 已启用：管理员运行 powercfg /hibernate on
default_after_done = "sleep"
# 完成判定命中后的反悔窗口（秒）。期间可调 /abort 阻止收尾动作。
grace_seconds = 30
# 内存中保留的最近任务历史条数（供 /status 与 NAS 展示）。
keep_history = 20

[tasks]
# 任务清单来源目录。该目录下所有 *.json 会被读取并合并（每个文件可是单任务对象或数组）。
# 相对路径相对于监听器目录；绝对路径原样使用。
# 支持热加载：修改/增删目录内 .json 后，下一次 /tasks 请求即生效，无需重启。
dir = "tasks"
